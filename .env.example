# Copy to .env and adjust. All values are optional.

# Host port (bound to 127.0.0.1 only).
UPTIME_PORT=8000

# Keep true in production (HTTPS via reverse proxy). Only set false for plain-HTTP testing
# on something other than localhost.
UPTIME_COOKIE_SECURE=true

# Comma-separated hostnames the app answers to, e.g. status.example.com
UPTIME_ALLOWED_HOSTS=

# Docker network subnet and the address whose X-Forwarded-For header is trusted.
# A reverse proxy on the Docker host connects from the network gateway (.1), so the
# defaults work as-is. Change both only if 172.30.0.0/24 clashes with your network.
UPTIME_SUBNET=172.30.0.0/24
UPTIME_FORWARDED_ALLOW_IPS=172.30.0.1

# Ports monitors may use. "*" allows any port.
UPTIME_ALLOWED_PORTS=80,443,8080,8443

# Allow monitoring private/internal addresses (disables SSRF protection). Keep false.
UPTIME_ALLOW_PRIVATE_TARGETS=false

# Extra IPs/CIDRs monitors may never reach, even with private targets allowed.
# Put the Docker host's own public IP addresses here (see README, outbound traffic).
UPTIME_BLOCKED_NETWORKS=

UPTIME_SESSION_TTL_HOURS=12
UPTIME_RAW_RETENTION_DAYS=30
UPTIME_PUBLIC_REFRESH_SECONDS=30
# Checks running at once (more wait in a queue). Keep <= 25 unless you raise pids_limit
# in docker-compose.yml to at least 3 x this value + 50.
UPTIME_CHECK_CONCURRENCY=10
